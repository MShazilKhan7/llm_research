 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Notebook 5 — Evaluation & Metrics\n",
    "\n",
    "Computes Accuracy, Precision, Recall, F1, and Confusion Matrix\n",
    "for all models (including ensemble) × tasks × strategies.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, os\n",
    "sys.path.insert(0, os.path.abspath('..'))\n",
    "\n",
    "RESULTS_DIR    = '../results'\n",
    "EVALUATION_DIR = '../evaluation'\n",
    "\n",
    "from evaluation.evaluate_all import evaluate_all\n",
    "\n",
    "all_metrics = evaluate_all(results_dir=RESULTS_DIR, output_dir=EVALUATION_DIR)\n",
    "print('\\n✓ Evaluation complete.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load summary tables"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "\n",
    "df_amb = pd.read_csv(f'{EVALUATION_DIR}/summary_ambiguity.csv')\n",
    "df_inc = pd.read_csv(f'{EVALUATION_DIR}/summary_incompleteness.csv')\n",
    "\n",
    "print('=== AMBIGUITY ===')\n",
    "display(df_amb[['model','strategy','accuracy','precision','recall','f1']].round(4))\n",
    "\n",
    "print('\\n=== INCOMPLETENESS ===')\n",
    "display(df_inc[['model','strategy','accuracy','precision','recall','f1']].round(4))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Best configuration per task"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for name, df in [('AMBIGUITY', df_amb), ('INCOMPLETENESS', df_inc)]:\n",
    "    best = df.loc[df['f1'].idxmax()]\n",
    "    print(f'\\n[{name}] Best model: {best[\"model\"]} | Strategy: {best[\"strategy\"]}')\n",
    "    print(f'  F1={best[\"f1\"]:.4f}  Acc={best[\"accuracy\"]:.4f}  '\n",
    "          f'P={best[\"precision\"]:.4f}  R={best[\"recall\"]:.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Pivot: F1 by model × strategy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for name, df in [('Ambiguity', df_amb), ('Incompleteness', df_inc)]:\n",
    "    pivot = df.pivot_table(index='model', columns='strategy', values='f1')\n",
    "    print(f'\\n── {name} F1 pivot ──')\n",
    "    display(pivot.round(4))"
   ]
  }
 ],
